PROVERYALKA_DATABASE_PATH=data/proveryalka.sqlite3
PROVERYALKA_ARTIFACTS_PATH=data/artifacts
# Аналитик: codex — локальный Codex app-server с подпиской ChatGPT (нужен выполненный codex login);
# openai — OpenAI-совместимый Responses API по ключу (endpoint МАИ отложен).
PROVERYALKA_LLM_PROVIDER=codex
PROVERYALKA_CODEX_BIN=codex
PROVERYALKA_CODEX_MODEL=
PROVERYALKA_CODEX_EFFORT=medium
OPENAI_BASE_URL=https://api-ai.mai.ru/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash
PROVERYALKA_JAVA=java
PROVERYALKA_TLA_JAR=tools/tla2tools.jar
PROVERYALKA_TLC_HEAP_MB=512
PROVERYALKA_TLC_PARALLEL=2
PROVERYALKA_CHECK_PARALLEL=2
PROVERYALKA_AGENT_PARALLEL=2
PROVERYALKA_MAX_PENDING_RUNS=32
PROVERYALKA_AGENT_TIMEOUT=630
PROVERYALKA_MAX_INPUT_CHARS=100000
PROVERYALKA_MAX_DOCUMENT_BYTES=5242880
PROVERYALKA_CHECK_CACHE=data/check-cache

# Local mode by default; enable only with user isolation (#80).
PROVERYALKA_AUTH_ENABLED=0
PROVERYALKA_AUTH_ORIGIN=http://127.0.0.1:8000
PROVERYALKA_AUTH_SESSION_SECONDS=43200
PROVERYALKA_SMTP_HOST=
PROVERYALKA_SMTP_PORT=465
PROVERYALKA_SMTP_USER=
PROVERYALKA_SMTP_PASSWORD=
PROVERYALKA_SMTP_SENDER=

# Required to save private Git credentials; Fernet key, kept outside the database/repo.
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVERYALKA_CONNECTION_KEY=
PROVERYALKA_GITLAB_HOST=
