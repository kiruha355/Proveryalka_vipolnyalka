{
  "$defs": {
    "CheckLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_states": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Max States",
          "type": "integer"
        },
        "max_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth"
        }
      },
      "title": "CheckLimits",
      "type": "object"
    },
    "CheckStatistics": {
      "additionalProperties": false,
      "properties": {
        "states_generated": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "States Generated"
        },
        "distinct_states": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct States"
        },
        "depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        }
      },
      "title": "CheckStatistics",
      "type": "object"
    },
    "EngineInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "transition_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transition Id"
        },
        "state": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "State",
          "type": "object"
        }
      },
      "required": [
        "number",
        "transition_id",
        "state"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "VerificationReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/VerificationResult"
          },
          "minItems": 1,
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "title": "VerificationReport",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        },
        "mode": {
          "enum": [
            "engine",
            "test"
          ],
          "title": "Mode",
          "type": "string"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/CheckLimits"
        },
        "property_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Property Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "PROPERTY_HOLDS",
            "PROPERTY_VIOLATED",
            "MODEL_INVALID",
            "TIMEOUT",
            "STATE_LIMIT_REACHED",
            "ENGINE_ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "conclusive": {
          "title": "Conclusive",
          "type": "boolean"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/TraceStep"
          },
          "title": "Trace",
          "type": "array"
        },
        "statistics": {
          "$ref": "#/$defs/CheckStatistics"
        },
        "related_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Related Requirements",
          "type": "array"
        }
      },
      "required": [
        "spec_hash",
        "mode",
        "executed",
        "engine",
        "limits",
        "property_id",
        "status",
        "conclusive",
        "message"
      ],
      "title": "VerificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event": {
      "enum": [
        "tool_started",
        "tool_finished",
        "tool_failed"
      ],
      "title": "Event",
      "type": "string"
    },
    "check_id": {
      "title": "Check Id",
      "type": "string"
    },
    "version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version Id"
    },
    "spec_hash": {
      "title": "Spec Hash",
      "type": "string"
    },
    "property_ids": {
      "items": {
        "type": "string"
      },
      "title": "Property Ids",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "event",
    "check_id",
    "version_id",
    "spec_hash",
    "property_ids"
  ],
  "title": "VerificationEvent",
  "type": "object"
}
