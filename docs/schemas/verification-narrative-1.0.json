{
  "$defs": {
    "PropertyExplanation": {
      "additionalProperties": false,
      "properties": {
        "property_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Property Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TraceComment"
          },
          "title": "Steps",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "type": "string"
          },
          "title": "Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "property_id",
        "explanation",
        "steps"
      ],
      "title": "PropertyExplanation",
      "type": "object"
    },
    "TraceComment": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "number",
        "explanation"
      ],
      "title": "TraceComment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PropertyExplanation"
      },
      "minItems": 1,
      "title": "Properties"
    }
  },
  "required": [
    "summary",
    "properties"
  ],
  "title": "VerificationNarrative",
  "type": "object"
}
