{
  "name": "@proveryalka/frontend-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Интерактивная диаграмма состояний BehavioralModel (#40) и просмотр сгенерированного проекта (#49) для клиента Проверялки",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/types/fixtures/index.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./styles.css": "./dist/frontend-extensions.css",
    "./source": "./src/index.ts",
    "./source/fixtures": "./src/fixtures/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "demo:build": "DEMO_PAGE=graph vite build --config vite.demo.config.ts && DEMO_PAGE=files vite build --config vite.demo.config.ts && node scripts/inline-demo.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
